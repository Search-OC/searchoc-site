---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import InterestForm from '../components/InterestForm.astro';
import MissionSections from '../components/MissionSections.astro';
import StayInTouch from '../components/StayInTouch.astro';

const audience = [
	'People who have been carrying a question for a long time.',
	'People who want an honest, low-pressure conversation.',
	'People who want to bring a friend who might actually say yes.',
	'People who may come once and decide that is enough for now.',
];

const faq = [
	{
		q: 'Do I have to believe anything specific?',
		a: 'No. This is for people exploring, questioning, or simply curious. No belief required to attend.',
	},
	{
		q: 'What if I disagree with something that is said?',
		a: 'Respectful disagreement is welcome. The goal is honest conversation, not agreement.',
	},
	{
		q: 'Is this a class or a service?',
		a: 'No. It is a small group conversation in a casual setting. There is no lecture you have to sit through, and no pressure at the end.',
	},
	{
		q: 'Can I come alone?',
		a: 'Yes. Many people do. People also invite friends. You are welcome either way.',
	},
	{
		q: 'Will I be put on the spot or asked to speak?',
		a: 'You can listen the whole time if you prefer. Participation is always optional.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(({ q, a }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: a },
	})),
};
---

<Layout
	title="Open Forums | Life's big questions"
	description="A hosted conversation in Orange County about life's big questions. Leave an email or a phone number to hear when the next table is set."
	canonical="/open-forums"
	ogImage="/og/forum.png"
>

<!-- Hero: same email-or-phone capture the homepage uses -->
<section class="hero-photo hero-photo--amber hero-photo--with-form">
	<div class="hero-photo__media" aria-hidden="true">
		<img
			src="/images/dinner-party.jpg"
			alt=""
			width="2400"
			height="1350"
			fetchpriority="high"
		/>
	</div>
	<div class="hero-photo__veil" aria-hidden="true"></div>
	<div class="hero-photo__content">
		<p class="brand-mark rise-in">Search OC</p>
		<p class="mt-3 font-sans text-xs font-bold uppercase tracking-[0.14em] text-white/85 rise-in rise-in-delay-1">Open Forums</p>
		<h1 class="mt-4 max-w-3xl text-2xl sm:text-3xl md:text-[2.5rem] font-bold tracking-tight leading-[1.12] rise-in rise-in-delay-1">
			Life's big questions
		</h1>
		<p class="mt-3 lead max-w-xl rise-in rise-in-delay-2">
			A hosted conversation over food and drinks. About an hour. Honest talk, no lecture, no pressure to agree. Come once if you want. That is enough.
		</p>
		<div class="stay-in-touch-on-dark mt-5 max-w-md rise-in rise-in-delay-3">
			<p class="mb-3 font-sans text-sm">
				Leave an email or a phone number. We will tell you when the next table is set.
			</p>
			<InterestForm
				formId="open-forums-hero-form"
				source="open-forums-hero"
				submitLabel="Let me know when the next one is"
				showName={false}
				showInterests={false}
				showFormationInterest={false}
				defaultInterests={['open-forums']}
				defaultNewsletter={false}
				compact={true}
				acceptPhone={true}
				successDetail="We will tell you when the next table is set."
			/>
		</div>
	</div>
</section>
<img class="sr-only" src="/images/dinner-party.jpg" alt="Friends gathered around a dinner table with food and candles" />

<MissionSections
	questionsEyebrow="The conversation"
	questionsHeading="The questions people actually carry"
	questionsLead="An Open Forum is a table for the questions that do not fit in a hallway or a group chat. You do not need the right words. You do not need to have it figured out."
	audience={audience}
	patioCaption="Eight to twelve people. One table. Room for honest questions."
/>

<!-- What to Expect -->
<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="What to expect" />
			<h2 class="mt-3 text-3xl font-bold tracking-tight">Three promises</h2>
			<div class="mt-8 space-y-4">
				<div class="cycle-step flex gap-4">
					<span class="cycle-number" aria-hidden="true">1</span>
					<div>
						<p class="font-sans font-semibold">Truly open</p>
						<p class="mt-1 text-sm text-[var(--muted)]">No question is off-limits. Doubt, anger, and skepticism are welcome.</p>
					</div>
				</div>
				<div class="cycle-step flex gap-4">
					<span class="cycle-number" aria-hidden="true">2</span>
					<div>
						<p class="font-sans font-semibold">About one hour</p>
						<p class="mt-1 text-sm text-[var(--muted)]">Moderated discussion with food and drinks around it. Not a marathon.</p>
					</div>
				</div>
				<div class="cycle-step flex gap-4">
					<span class="cycle-number" aria-hidden="true">3</span>
					<div>
						<p class="font-sans font-semibold">Guests speak first</p>
						<p class="mt-1 text-sm text-[var(--muted)]">Your questions lead. You can listen the whole time if you prefer.</p>
					</div>
				</div>
			</div>

			<h3 class="mt-10 font-sans text-xl font-bold tracking-tight">How a night typically flows</h3>
			<ol class="mt-4 space-y-2 text-[var(--muted)] list-decimal pl-5">
				<li>Arrive, food and drinks, settle in.</li>
				<li>Moderated conversation, about an hour.</li>
				<li>Optional dessert or continued conversation for those who want to stay.</li>
			</ol>
		</div>
	</div>
</section>

<!-- Where the ecosystem goes next -->
<section class="section-sage section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="Bring someone" />
			<h2 class="mt-3 text-3xl font-bold tracking-tight">Invite a friend</h2>
			<p class="mt-4 text-[var(--muted)] leading-relaxed">
				If someone in your life has been carrying one of these questions, you can bring them. Guests are welcome even if they only know one person in the room.
			</p>
			<p class="mt-4">
				<a href="/invite" class="font-sans font-semibold text-[var(--search-blue-action)] hover:underline">
					Get copy-paste texts you can actually send &rarr;
				</a>
			</p>
			<p class="mt-3 text-sm text-[var(--muted)]">
				Privacy matters: no photos or video, and no social posting about who attends.
			</p>
			<div class="mt-8 grid sm:grid-cols-3 gap-4">
				<a href="/formation" class="card hover:border-[var(--search-blue-action)] transition">
					<p class="font-sans font-semibold text-[var(--ink)]">Formation</p>
					<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">A 12-week cohort for Christians who want to talk about faith without the guilt cycle.</p>
				</a>
				<a href="/foundation" class="card hover:border-[var(--search-blue-action)] transition">
					<p class="font-sans font-semibold text-[var(--ink)]">Foundations</p>
					<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">A small-group book series for people who want to keep going after the questions start landing.</p>
				</a>
				<a href="/resources" class="card hover:border-[var(--search-blue-action)] transition">
					<p class="font-sans font-semibold text-[var(--ink)]">Resources</p>
					<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">Podcasts, books, and tools worth handing to a friend who is exploring.</p>
				</a>
			</div>
		</div>
	</div>
</section>

<StayInTouch
	id="stay-in-touch"
	eyebrow="The next gathering"
	title="Get notified of the next gathering"
	body="We keep the group small and the setting comfortable. When a table is set, we write the people who asked to hear about it. Leave an email or a phone number. That is the whole ask."
	source="open-forums"
	variant="warm"
	submitLabel="Notify me"
	showName={true}
	showInterests={false}
	defaultInterests={['open-forums']}
	defaultNewsletter={false}
	acceptPhone={true}
	successDetail="We will tell you when the next table is set."
/>

<!-- FAQ -->
<section class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="Questions" />
			<h2 class="mt-3 text-3xl font-bold tracking-tight mb-8">FAQ</h2>
			<div class="space-y-6">
				{faq.map(({ q, a }) => (
					<div>
						<p class="font-sans font-semibold text-[var(--ink)]">{q}</p>
						<p class="mt-1 text-[var(--muted)]">{a}</p>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
