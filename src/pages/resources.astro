---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import StayInTouch from '../components/StayInTouch.astro';

const forYou = [
	{
		title: 'REACH Video Series',
		body: 'A free, self-paced course on sharing Jesus in everyday moments. Six short sections, each lesson under 10 minutes. Do it solo or with a group.',
		href: 'https://reachothers.org/series',
		cta: 'Start the course',
		external: true,
	},
	{
		title: 'Search Formation',
		body: 'A free 12-week training that walks a small group through relational evangelism, from the basics of the gospel to leading real conversations.',
		href: '/formation',
		cta: 'Learn more about Formation',
		external: false,
	},
	{
		title: 'Reach Tools',
		body: 'Practical, bite-sized tools for gospel conversations. Grab what you need when you need it.',
		href: 'https://reachothers.org',
		cta: 'Browse the tools',
		external: true,
	},
	{
		title: 'The Foundations Series',
		body: 'Short group studies that build on each other: Inquire, Explore, Grow, Speak, Listen, Invest, and Invite. Made for a small group or a one-on-one.',
		href: '/foundation',
		cta: 'See the series',
		external: false,
	},
];

const forAFriend = [
	{
		title: 'Open Forum',
		body: 'A table in Orange County where curious people talk through life\'s big questions. No lecture, no pressure. Just honest conversation over food and drinks.',
		href: '/open-forums',
		cta: 'See what a night is like',
		external: false,
	},
	{
		title: 'The Search Podcast',
		body: 'Honest conversations about life\'s biggest questions, with candor and curiosity. No topic is off-limits.',
		href: 'https://podcasts.apple.com/us/podcast/the-search-podcast-discussing-lifes-big-questions/id1506488626',
		cta: 'Listen on Apple Podcasts',
		external: true,
	},
	{
		title: 'The Questioning God Podcast',
		body: 'Exploring the hard questions about God and faith. Co-hosts put the facts on the table and leave room for real doubt.',
		href: 'https://podcasts.apple.com/us/podcast/the-questioning-god-podcast/id1592370050',
		cta: 'Listen on Apple Podcasts',
		external: true,
	},
	{
		title: 'The Search for Meaning Podcast',
		body: 'Conversations about purpose, doubt, and meaning.',
		href: 'https://podcasts.apple.com/us/podcast/the-search-for-meaning/id1208170802',
		cta: 'Listen on Apple Podcasts',
		external: true,
	},
];

const books = [
	{
		title: 'Questioning God?',
		subtitle: 'Answers to Questions Worth Asking',
		author: 'Dr. John Hopper',
		body: 'Invites people who are skeptical of Christianity, or doubting their faith, to consider honest answers to commonly asked questions. Conversational in style. Written for anyone who wants to explore, challenge, or understand why Christianity remains relevant.',
	},
	{
		title: 'Giving Jesus Away',
		subtitle: 'Finding Joy in Sharing the Gospel',
		author: 'Dr. John Hopper',
		body: 'Starts with a simple question: why do Christians feel uncomfortable or unskilled at sharing the gospel? Practical strategies for talking about Jesus inside ordinary relationships, from starting conversations to telling your own story.',
	},
	{
		title: 'Why I Still Believe',
		subtitle: '',
		author: 'Mary Jo Sharp',
		body: 'For anyone wrestling with the gap between the beauty of God\'s story and the failures of His people. A once-skeptical believer describes how hard questions ultimately led her toward faith, not away from it.',
	},
];
---

<Layout
	title="Resources | Search OC"
	description="Free resources for better conversations about faith. Tools for you, and for a friend who is exploring."
	canonical="/resources"
	ogImage="/og/resources.png"
>

<section class="hero-photo">
	<div class="hero-photo__media" aria-hidden="true">
		<img
			src="/images/writing-coffee.jpg"
			alt=""
			width="2400"
			height="1350"
			fetchpriority="high"
		/>
	</div>
	<div class="hero-photo__veil" aria-hidden="true"></div>
	<div class="hero-photo__content">
		<p class="brand-mark rise-in">Search OC</p>
		<p class="mt-3 font-sans text-xs font-bold uppercase tracking-[0.14em] text-white/85 rise-in rise-in-delay-1">Resources</p>
		<h1 class="mt-4 max-w-3xl text-3xl md:text-[2.75rem] font-bold tracking-tight leading-[1.12] rise-in rise-in-delay-1">
			Free resources for better conversations about faith.
		</h1>
		<p class="mt-5 lead max-w-xl rise-in rise-in-delay-2">
			Everything here is free. Some of it is for you, to help you talk about what you believe without feeling awkward. Some of it is for a friend who is curious and asking real questions. Take what helps. Share what fits.
		</p>
	</div>
</section>
<img class="sr-only" src="/images/writing-coffee.jpg" alt="A notebook and coffee on a table, ready for quiet reading" />

<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="For you" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">Get better at sharing your faith</h2>
		</div>
		<div class="mt-10 grid sm:grid-cols-2 gap-6">
			{forYou.map((item) => (
				<div class="card">
					<p class="font-sans font-semibold text-[var(--ink)]">{item.title}</p>
					<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">{item.body}</p>
					<p class="mt-4">
						<a
							href={item.href}
							class="font-sans text-sm font-semibold text-[var(--search-blue-action)] hover:underline"
							{...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
						>
							{item.cta} &rarr;
						</a>
					</p>
				</div>
			))}
		</div>
	</div>
</section>

<figure class="media-band" style="min-height: 10rem;">
	<img
		src="/images/coffee-table.jpg"
		alt="Coffee cups and an open book on a wooden table"
		width="2400"
		height="1350"
		loading="lazy"
	/>
</figure>

<section class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="For a friend" variant="amber" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">For a friend who is exploring</h2>
			<p class="mt-4 lead">
				Hand them something that matches where they actually are. A table, a podcast, or a book. Nothing here asks them to decide anything tonight.
			</p>
		</div>
		<div class="mt-10 grid sm:grid-cols-2 gap-6">
			{forAFriend.map((item) => (
				<div class="card">
					<p class="font-sans font-semibold text-[var(--ink)]">{item.title}</p>
					<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">{item.body}</p>
					<p class="mt-4">
						<a
							href={item.href}
							class="font-sans text-sm font-semibold text-[var(--search-blue-action)] hover:underline"
							{...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
						>
							{item.cta} &rarr;
						</a>
					</p>
				</div>
			))}
		</div>
	</div>
</section>

<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="Books" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">Books worth handing over</h2>
			<p class="mt-4 lead">
				Three titles from Search Ministries. Each one is written for a real conversation, not a classroom.
			</p>
		</div>
		<div class="mt-10 space-y-6 max-w-3xl">
			{books.map((book) => (
				<article class="card">
					<h3 class="font-sans font-bold text-xl text-[var(--ink)]">{book.title}</h3>
					{book.subtitle && (
						<p class="mt-1 font-sans text-sm text-[var(--muted)]">{book.subtitle}</p>
					)}
					<p class="mt-1 font-sans text-sm font-semibold text-[var(--search-blue-action)]">{book.author}</p>
					<p class="mt-3 text-sm text-[var(--muted)] leading-relaxed">{book.body}</p>
				</article>
			))}
		</div>
		<p class="mt-8 max-w-3xl text-sm text-[var(--muted)]">
			Looking for more? Search National keeps the full catalog at{' '}
			<a
				href="https://searchnational.org/resources"
				class="font-sans font-semibold text-[var(--search-blue-action)] hover:underline"
				target="_blank"
				rel="noopener noreferrer"
			>
				searchnational.org/resources
			</a>.
		</p>
	</div>
</section>

<section class="section-sage section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="Ready to reach others?" />
			<h2 class="mt-3 text-3xl font-bold tracking-tight">Start with REACH</h2>
			<p class="mt-4 text-[var(--muted)] leading-relaxed">
				REACH is Search's free training for relational evangelism. It equips you to start conversations about Jesus, address questions about God and life, and build one-on-one relationships with people who do not yet believe.
			</p>
			<p class="mt-6">
				<a
					href="https://reachothers.org"
					class="btn-primary min-h-11 inline-flex items-center"
					target="_blank"
					rel="noopener noreferrer"
				>
					Go to reachothers.org
				</a>
			</p>
		</div>
	</div>
</section>

<StayInTouch
	id="stay-in-touch"
	eyebrow="Stay in touch"
	title="Having Killer Conversations"
	body="A short note every other week for Christians who want to talk about faith without being weird about it. Leave an email."
	source="resources"
	variant="warm"
	submitLabel="Subscribe"
	showName={false}
	showInterests={false}
	defaultInterests={['general']}
	defaultNewsletter={true}
/>
</Layout>
