---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import GuiltCycle from '../components/GuiltCycle.astro';
import CTABlock from '../components/CTABlock.astro';

const weeks = [
	'The Person of Christ',
	'The Problem of Sin',
	'The Provision of Jesus',
	'The Resurrection of Jesus',
	'Our Response to Jesus',
	'Truth',
	'The Reliability of the Bible',
	'Is Jesus the Only Way?',
	'The Problem of Evil and Suffering',
	"Will God Judge Those Who Haven't Heard About Jesus?",
	'Preparing for a Forum',
	'Commissioning'
];
---

<Layout
	title="Formation | Search OC"
	description="A 12-week cohort for Christians who want to talk about their faith without guilt, pressure, or awkwardness."
	canonical="/formation"
	ogImage="/og/formation.png"
/>

<!-- Hero -->
<section class="hero-gradient">
	<div class="max-w-5xl mx-auto px-6 pt-16 pb-12 md:pt-20">
		<div class="max-w-3xl">
			<Eyebrow text="Search Formation" />
			<h1 class="mt-4 text-4xl md:text-5xl font-bold tracking-tight leading-[1.1]">
				Stop feeling guilty about not sharing your faith. Start having conversations that actually work.
			</h1>
			<p class="mt-5 lead">
				Formation is a 12-week cohort for everyday Christians who want to move past the guilt cycle into a practical, sustainable way of loving people and talking about God in real life.
			</p>
			<div class="mt-7 flex flex-wrap gap-3">
				<a href="#how-to-begin" class="btn-primary min-h-11 inline-flex items-center">Start the conversation</a>
				<a href="#model" class="btn-secondary min-h-11 inline-flex items-center">See the 1-2-3 model</a>
			</div>
		</div>
	</div>
</section>

<!-- Guilt Cycle -->
<section class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-2xl mb-10">
			<Eyebrow text="Why Formation exists" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">You are not the problem. The approach is.</h2>
			<p class="mt-4 lead">
				Most Christians were never taught how to share their faith in a way that fits real relationships. Formation replaces guilt and pressure with skills, confidence, and a model you can actually use Monday through Friday.
			</p>
		</div>
		<GuiltCycle />
	</div>
</section>

<!-- What Formation Does -->
<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="grid md:grid-cols-3 gap-6">
			<div class="card">
				<p class="font-sans font-semibold text-[var(--ink)]">Deepen your love for people</p>
				<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">Move from obligation to genuine care for the people God has placed in your life.</p>
			</div>
			<div class="card">
				<p class="font-sans font-semibold text-[var(--ink)]">Build a vision for personal ministry</p>
				<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">See your workplace, neighborhood, and friendships as places where God is already at work.</p>
			</div>
			<div class="card">
				<p class="font-sans font-semibold text-[var(--ink)]">Practice relational evangelism</p>
				<p class="mt-2 text-sm text-[var(--muted)] leading-relaxed">Learn to ask better questions, listen well, and invite honest conversations without scripts or pressure.</p>
			</div>
		</div>
	</div>
</section>

<!-- 1-2-3 Model -->
<section id="model" class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<Eyebrow text="The framework" />
		<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight mb-8">The Search 1-2-3 model</h2>
		<div class="grid md:grid-cols-3 gap-6">
			<div class="card">
				<div class="text-4xl font-bold text-[var(--search-blue)] mb-3 font-sans" aria-hidden="true">1</div>
				<h3 class="font-sans font-bold text-xl">Value the one</h3>
				<p class="mt-2 text-[var(--muted)] text-sm leading-relaxed">Focus on the person in front of you. One conversation at a time. Presence over programs.</p>
			</div>
			<div class="card">
				<div class="text-4xl font-bold text-[var(--search-blue)] mb-3 font-sans" aria-hidden="true">2</div>
				<h3 class="font-sans font-bold text-xl">Two principles</h3>
				<ul class="mt-2 text-[var(--muted)] space-y-2 text-sm leading-relaxed">
					<li>God is responsible for the results.</li>
					<li>A person's spiritual journey is a process.</li>
				</ul>
			</div>
			<div class="card">
				<div class="text-4xl font-bold text-[var(--search-blue)] mb-3 font-sans" aria-hidden="true">3</div>
				<h3 class="font-sans font-bold text-xl">Three barriers</h3>
				<p class="mt-2 text-[var(--muted)] text-sm leading-relaxed">Intellectual. Emotional. Spiritual. Formation addresses each with gentleness and clarity, not arguments.</p>
			</div>
		</div>
	</div>
</section>

<!-- 12-week path -->
<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<Eyebrow text="The curriculum" />
		<h2 class="mt-3 text-3xl font-bold tracking-tight mb-2">12 weeks, one honest question at a time</h2>
		<p class="text-[var(--muted)] mb-8">A structured but relational journey through the core questions of faith.</p>
		<ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm list-none p-0 m-0">
			{weeks.map((title, i) => (
				<li class="cycle-step py-3 px-4 flex items-start gap-3">
					<span class="font-sans text-[var(--search-blue)] w-7 shrink-0 font-bold">{i + 1}.</span>
					<span class="text-[var(--ink)]">{title}</span>
				</li>
			))}
		</ol>
	</div>
</section>

<!-- What is a Forum -->
<section class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="Where it leads" />
			<h2 class="mt-3 text-3xl font-bold tracking-tight">What is a Forum?</h2>
			<p class="mt-4 lead">
				A Forum is a one-hour discussion where guests explore core questions about God and life in a comfortable setting over food and drinks.
			</p>
			<p class="mt-4 text-[var(--muted)] leading-relaxed">
				The goal is not to win a debate. It is to deepen trust, invite honest reflection, and create space for meaningful follow-up. Formation trains you to host and invite people to these conversations.
			</p>
			<p class="mt-6 callout max-w-lg">"More Jesus. Less awkward."</p>
		</div>
	</div>
</section>

<!-- Credibility -->
<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="Why Search" />
			<h2 class="mt-3 text-3xl font-bold tracking-tight">Trusted, not trendy</h2>
			<p class="mt-4 text-[var(--muted)] leading-relaxed">
				Search Ministries has served adults for nearly 50 years. Search Orange County has served locally for just over 40 years. We are not selling a new method. We are passing on a proven way of having conversations about God that actually work in real relationships.
			</p>
		</div>
	</div>
</section>

<!-- How to begin -->
<section id="how-to-begin" class="section-warm section-tight">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-2xl">
			<h2 class="text-3xl font-bold tracking-tight">How to begin</h2>
			<p class="mt-4 text-[var(--muted)] leading-relaxed">
				Whether you lead a church, a small group, or simply want to grow in having better conversations about faith at work and in life, Formation can help.
			</p>
			<div class="mt-6">
				<a href="mailto:jake@searchoc.org" class="btn-primary inline-flex min-h-11 items-center">Start the conversation</a>
			</div>
			<p class="mt-4 text-sm text-[var(--cool-gray)] font-sans">Jake Hartson, Area Director &middot; jake@searchoc.org</p>
		</div>
	</div>
</section>

<CTABlock
	title="Your next conversation starts here"
	body="No pressure, no commitment required to reach out. Just tell Jake where you are and what you are hoping for."
	primaryLabel="Email Jake"
	primaryHref="mailto:jake@searchoc.org"
	variant="blue"
/>
