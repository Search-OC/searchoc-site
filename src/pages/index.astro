---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import GuiltCycle from '../components/GuiltCycle.astro';
import StoryBrandProblem from '../components/StoryBrandProblem.astro';
import GuideSection from '../components/GuideSection.astro';
import StoryBrandPlan from '../components/StoryBrandPlan.astro';
import StakesSection from '../components/StakesSection.astro';
import StayInTouch from '../components/StayInTouch.astro';
---

<Layout
	title="Search OC | Talk about your faith without the guilt"
	description="For Christians in the marketplace who want to share their faith but don't know how. Search OC helps you break the Great Commission guilt cycle."
	canonical="/"
	ogImage="/og/home.png"
>

<!-- Hero: brand + character + problem (StoryBrand), full-bleed marketplace photo -->
<section class="hero-photo">
	<div class="hero-photo__media" aria-hidden="true">
		<img
			src="/images/cafe-conversation.jpg"
			alt=""
			width="2400"
			height="1350"
			fetchpriority="high"
		/>
	</div>
	<div class="hero-photo__veil" aria-hidden="true"></div>
	<div class="hero-photo__content">
		<p class="brand-mark rise-in">Search OC</p>
		<h1 class="mt-5 max-w-3xl text-3xl md:text-[2.75rem] font-bold tracking-tight leading-[1.12] rise-in rise-in-delay-1">
			You want to share your faith. You just don't know how to do it without making things weird.
		</h1>
		<p class="mt-5 lead max-w-xl rise-in rise-in-delay-2">
			We help Christians in the marketplace break the guilt cycle and start conversations that actually work.
		</p>
		<div class="mt-8 flex flex-col sm:flex-row gap-3 rise-in rise-in-delay-3">
			<a href="#plan" class="btn-primary inline-flex items-center justify-center min-h-11">Show me the plan</a>
			<a href="#the-cycle" class="btn-secondary inline-flex items-center justify-center min-h-11">Does this sound like you?</a>
		</div>
	</div>
</section>
<img
	class="sr-only"
	src="/images/cafe-conversation.jpg"
	alt="Friends talking and laughing together at a bright cafe table"
/>

<!-- Problem: 3 levels -->
<section class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-2xl mb-10">
			<Eyebrow text="The problem" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">It is not that you do not care</h2>
			<p class="mt-4 lead">
				Most Christians in the marketplace feel the same tension. The guilt is internal. The stakes are real. And the old playbook was never built for your actual relationships.
			</p>
		</div>
		<StoryBrandProblem />
	</div>
</section>

<!-- Guilt Cycle -->
<section id="the-cycle" class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-2xl mb-10">
			<Eyebrow text="Sound familiar?" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">The Great Commission guilt cycle</h2>
			<p class="mt-4 text-[var(--muted)] leading-relaxed">
				This loop is why good-hearted Christians go quiet. Naming it is the first step out.
			</p>
		</div>
		<GuiltCycle />
	</div>
</section>

<!-- Atmospheric break -->
<figure class="media-band">
	<img
		src="/images/coffee-table.jpg"
		alt="A latte on a wooden cafe table during a quiet conversation"
		width="2400"
		height="1350"
		loading="lazy"
	/>
	<figcaption class="media-band__caption">Real conversations happen at ordinary tables.</figcaption>
</figure>

<!-- Guide: Empathy + Authority -->
<GuideSection />

<!-- Plan -->
<section id="plan" class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-2xl mb-10">
			<Eyebrow text="The plan" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">Three steps. No performance required.</h2>
			<p class="mt-4 text-[var(--muted)] leading-relaxed">
				You do not need to become an expert. You need a simple path and a guide who has walked this with thousands of people before you.
			</p>
		</div>
		<StoryBrandPlan />
		<div class="mt-8 callout max-w-2xl">
			"More Jesus. Less awkward."
		</div>
	</div>
</section>

<!-- Pathways -->
<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-2xl mb-10">
			<Eyebrow text="Pick your next step" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">Start where you actually are</h2>
			<p class="mt-4 text-[var(--muted)]">
				Need training for yourself, or a table to invite a friend to? Both paths lead to the same place: one honest conversation at a time.
			</p>
		</div>
		<div class="grid md:grid-cols-2 gap-6">
			<a href="/formation" class="card card-interactive block group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--search-blue)]">
				<div class="pathway-media">
					<img
						src="/images/women-cafe.jpg"
						alt="Two women talking over coffee in a bright cafe"
						width="2400"
						height="1350"
						loading="lazy"
					/>
				</div>
				<Eyebrow text="For you" />
				<h3 class="mt-2 text-2xl font-bold group-hover:text-[var(--search-blue-action)] transition">Search Formation</h3>
				<p class="mt-3 text-[var(--muted)] leading-relaxed">
					A 12-week cohort for Christians who are done with the guilt cycle. Learn to value the person, ask better questions, and invite honest conversations without scripts.
				</p>
				<span class="mt-5 inline-flex items-center text-sm font-semibold font-sans text-[var(--search-blue-action)]">
					Explore Formation &rarr;
				</span>
			</a>
			<a href="/open-forums" class="card card-interactive block group focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--search-blue)]">
				<div class="pathway-media">
					<img
						src="/images/window-conversation.jpg"
						alt="Two men laughing together by a bright cafe window"
						width="2400"
						height="1350"
						loading="lazy"
					/>
				</div>
				<Eyebrow text="For your friend" variant="amber" />
				<h3 class="mt-2 text-2xl font-bold group-hover:text-[var(--search-blue-action)] transition">Open Forums</h3>
				<p class="mt-3 text-[var(--muted)] leading-relaxed">
					One hour, food and drinks, no sermon. A hosted conversation about God and life's big questions. The kind of table your curious friend might actually say yes to.
				</p>
				<span class="mt-5 inline-flex items-center text-sm font-semibold font-sans text-[var(--search-blue-action)]">
					Explore Open Forums &rarr;
				</span>
			</a>
		</div>
		<p class="mt-8 text-center">
			<a href="/invite" class="font-sans font-semibold text-[var(--orange-action)] hover:underline">
				Already know who you would invite? Here is how to ask &rarr;
			</a>
		</p>
	</div>
</section>

<!-- Stakes: Failure vs Success -->
<StakesSection />

<figure class="media-band" style="min-height: 14rem;">
	<img
		src="/images/outdoor-friends.jpg"
		alt="A diverse group of friends laughing together outdoors"
		width="2400"
		height="1350"
		loading="lazy"
	/>
	<figcaption class="media-band__caption">Success looks like real friendships and honest talk.</figcaption>
</figure>

<figure class="media-band" style="min-height: 12rem;">
	<img
		src="/images/writing-coffee.jpg"
		alt="Someone writing at a wooden table next to a coffee mug"
		width="2400"
		height="1350"
		loading="lazy"
	/>
	<figcaption class="media-band__caption">Take one small next step. We will meet you there.</figcaption>
</figure>

<!-- CTA -->
<StayInTouch
	id="stay-in-touch"
	eyebrow="Take the next step"
	title="Ready to stop going in circles?"
	body="Tell us what you need: Formation details, upcoming Open Forums, or our newsletter Having Killer Conversations. Choose what fits. No pressure, no spam."
	source="home"
	variant="blue"
	defaultNewsletter={false}
	submitLabel="Start here"
/>
</Layout>
