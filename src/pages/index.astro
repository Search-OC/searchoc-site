---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import InterestForm from '../components/InterestForm.astro';

const questions = [
	'Why is there evil and suffering in the world?',
	'Where do we come from?',
	'Why are we here?',
	'What is our purpose?',
	'Is this the way things were intended, or is there a greater plan out there?',
];
---

<Layout
	title="Search OC | There is no safe room for that question"
	description="There is no safe room for that question. Open Forum is a table in Orange County. Leave an email or a phone number to hear when the next one is set."
	canonical="/"
	ogImage="/og/home.png"
>

<section class="hero-photo hero-photo--amber hero-photo--with-form">
	<div class="hero-photo__media" aria-hidden="true">
		<img
			src="/images/dinner-party.jpg"
			alt=""
			width="2400"
			height="1350"
			fetchpriority="high"
		/>
	</div>
	<div class="hero-photo__veil" aria-hidden="true"></div>
	<div class="hero-photo__content">
		<p class="font-sans text-xs font-bold uppercase tracking-[0.14em] text-white/85 rise-in">Open Forum</p>
		<h1 class="mt-3 max-w-3xl text-2xl sm:text-3xl md:text-[2.5rem] font-bold tracking-tight leading-[1.12] rise-in rise-in-delay-1">
			There is no safe room for that question.
		</h1>
		<p class="mt-3 lead max-w-xl rise-in rise-in-delay-2">
			You walked away from church, or you never found a group that goes that deep. You still want to think critically about the world and what you are experiencing. Bring your questions. Learn with others who are exploring something similar.
		</p>
		<p class="mt-3 max-w-xl font-sans text-sm md:text-base rise-in rise-in-delay-2">
			Open Forum is the table. Food, drinks, honest conversation. No lecture. No pressure.
		</p>
		<div id="stay-in-touch" class="stay-in-touch-on-dark mt-5 max-w-md rise-in rise-in-delay-3">
			<p class="mb-3 font-sans text-sm">
				Leave an email or a phone number. We will tell you when the next table is set.
			</p>
			<InterestForm
				formId="stay-in-touch-form"
				source="home"
				submitLabel="Let me know when the next one is"
				showName={false}
				showInterests={false}
				showFormationInterest={false}
				defaultInterests={['open-forums']}
				defaultNewsletter={false}
				compact={true}
				acceptPhone={true}
				successDetail="We will tell you when the next table is set."
			/>
		</div>
	</div>
</section>
<img
	class="sr-only"
	src="/images/dinner-party.jpg"
	alt="Friends gathered around a dinner table with food and candles"
/>

<section class="section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="max-w-3xl">
			<Eyebrow text="What a night is" />
			<h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">A table for the questions that linger</h2>
			<p class="mt-4 lead">
				An Open Forum is a hosted conversation over food and drinks. About an hour. No lecture. No pressure to agree. Room for the questions you actually have.
			</p>
		</div>
		<ol class="mt-10 max-w-3xl space-y-3 list-none p-0 m-0">
			{questions.map((question, i) => (
				<li class="cycle-step flex gap-4">
					<span class="cycle-number" aria-hidden="true">{i + 1}</span>
					<p class="font-sans font-semibold text-[var(--ink)] pt-0.5">{question}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<figure class="media-band">
	<img
		src="/images/forum-discussion.jpg"
		alt="Friends laughing around a table with books and coffee during an evening discussion"
		width="2400"
		height="1350"
		loading="lazy"
	/>
	<figcaption class="media-band__caption">Food, drinks, and honest questions. That is the whole night.</figcaption>
</figure>

<section class="section-warm section">
	<div class="max-w-5xl mx-auto px-6">
		<div class="grid md:grid-cols-2 gap-8">
			<div>
				<Eyebrow text="Who it is for" />
				<ul class="mt-4 space-y-3 text-[var(--muted)]">
					<li class="flex gap-2"><span class="text-[var(--search-blue-action)] font-bold" aria-hidden="true">&bull;</span> People who walked away from church and still have questions.</li>
					<li class="flex gap-2"><span class="text-[var(--search-blue-action)] font-bold" aria-hidden="true">&bull;</span> People who never found a group that goes that deep.</li>
					<li class="flex gap-2"><span class="text-[var(--search-blue-action)] font-bold" aria-hidden="true">&bull;</span> People who want to think critically, not be talked into a conclusion.</li>
					<li class="flex gap-2"><span class="text-[var(--search-blue-action)] font-bold" aria-hidden="true">&bull;</span> People who may come once and decide that is enough for now.</li>
				</ul>
			</div>
			<div>
				<Eyebrow text="What it is not" variant="amber" />
				<ul class="mt-4 space-y-3 text-[var(--muted)]">
					<li class="flex gap-2"><span class="text-[var(--orange)] font-bold" aria-hidden="true">&times;</span> A lecture or a class.</li>
					<li class="flex gap-2"><span class="text-[var(--orange)] font-bold" aria-hidden="true">&times;</span> A debate to win.</li>
					<li class="flex gap-2"><span class="text-[var(--orange)] font-bold" aria-hidden="true">&times;</span> Pressure to agree, join, or decide anything.</li>
					<li class="flex gap-2"><span class="text-[var(--orange)] font-bold" aria-hidden="true">&times;</span> Content for social media about who attended.</li>
				</ul>
			</div>
		</div>
	</div>
</section>

<figure class="media-band" style="min-height: 14rem;">
	<img
		src="/images/patio-gathering.jpg"
		alt="A diverse group of friends laughing around an outdoor patio table"
		width="2400"
		height="1350"
		loading="lazy"
	/>
	<figcaption class="media-band__caption">A table. Room for the question you brought.</figcaption>
</figure>
</Layout>
