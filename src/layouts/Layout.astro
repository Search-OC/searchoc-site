---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import InterestForm from '../components/InterestForm.astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogDescription?: string;
}

const SITE = 'https://searchoc.org';

const {
	title = "Search OC | Life's big questions",
	description = 'A table in Orange County for life\'s big questions. Leave an email to get notified of the next Open Forum gathering.',
	canonical = '/',
	ogImage = '/og/home.png',
	ogDescription = description
} = Astro.props;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const showNewsletter =
	path === '/formation' ||
	path.startsWith('/formation/') ||
	path === '/foundation' ||
	path.startsWith('/foundation/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={SITE + canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={SITE + canonical} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<script defer data-domain="searchoc.org" src="https://plausible.io/js/plausible.js"></script>
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Search OC",
			"description": "Search OC hosts Open Forums in Orange County: a table for life's big questions.",
			"url": "https://searchoc.org",
			"areaServed": {
				"@type": "Place",
				"name": "Orange County, California"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "Search Ministries"
			}
		}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<SpeedInsights />
		<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--surface)]/90 backdrop-blur-md">
			<div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between gap-4">
				<a href="/" class="font-sans text-sm sm:text-lg font-bold tracking-tight text-[var(--search-blue-action)] min-h-11 min-w-0 inline-flex items-center gap-2">
					<span class="inline-block w-2.5 h-2.5 rounded-sm bg-[var(--orange)] shrink-0" aria-hidden="true"></span>
					<span class="leading-tight">Search Orange County</span>
				</a>
				<a href="/#stay-in-touch" class="shrink-0 min-h-11 px-4 py-2 rounded-xl bg-[var(--search-blue-action)] text-white text-sm font-semibold font-sans hover:bg-[var(--dark-teal)] transition inline-flex items-center justify-center shadow-sm">
					Get involved
				</a>
			</div>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="border-t border-[var(--border)] bg-[var(--surface)] mt-8">
			<div class="max-w-5xl mx-auto px-6 py-12">
				<div class:list={[showNewsletter && 'grid md:grid-cols-2 gap-10']}>
					<div>
						<p class="font-sans font-bold text-[var(--search-blue-action)] text-lg">Search Orange County</p>
						<p class="mt-2 text-[var(--muted)] max-w-md leading-relaxed">
							Search OC hosts Open Forums in Orange County: a table for life's big questions. A local expression of Search Ministries, serving Orange County for over 40 years.
						</p>
						<p class="mt-4 font-sans text-sm text-[var(--cool-gray)]">Orange County, California</p>
					</div>
					{showNewsletter && (
						<div>
							<p class="font-sans font-semibold text-[var(--ink)] mb-1">Having Killer Conversations</p>
							<p class="text-sm text-[var(--muted)] mb-4">
								A short note every other week for Christians who want to talk about faith without being weird about it.
							</p>
							<InterestForm
								formId="footer-form"
								source="footer"
								submitLabel="Subscribe"
								showName={false}
								showInterests={false}
								defaultNewsletter={true}
								compact={true}
							/>
						</div>
					)}
				</div>
				<div class="mt-10 pt-6 border-t border-[var(--border)] text-xs text-[var(--cool-gray)] font-sans">
					<p>Honest questions. Real conversation.</p>
				</div>
			</div>
		</footer>
	</body>
</html>
