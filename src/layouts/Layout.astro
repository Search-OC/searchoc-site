---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogDescription?: string;
}

const {
	title = 'Search OC | Talk about your faith without the guilt',
	description = 'For Christians in the marketplace who want to share their faith but do not know how. Search OC trains you to have honest conversations that actually work.',
	canonical = '/',
	ogImage = '/og/card.svg',
	ogDescription = description
} = Astro.props;

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/formation', label: 'Formation' },
	{ href: '/open-forums', label: 'Open Forums' },
	{ href: '/invite', label: 'Invite Someone' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={'https://searchoc.org' + canonical} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImage} />
		<script defer data-domain="searchoc.org" src="https://plausible.io/js/plausible.js"></script>
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Search OC",
			"description": "Search OC equips Christians in the marketplace to share their faith through honest, relational conversations.",
			"url": "https://searchoc.org",
			"email": "jake@searchoc.org",
			"areaServed": {
				"@type": "Place",
				"name": "Orange County, California"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "Search Ministries"
			}
		}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<SpeedInsights />
		<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--surface)]/90 backdrop-blur-md">
			<nav class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between gap-4" aria-label="Primary">
				<a href="/" class="font-sans text-lg font-bold tracking-tight text-[var(--search-blue)] min-h-11 inline-flex items-center gap-2">
					<span class="inline-block w-2 h-2 rounded-full bg-[var(--warm-amber)]" aria-hidden="true"></span>
					Search OC
				</a>
				<div class="hidden md:flex items-center gap-1 text-sm font-medium font-sans">
					{navLinks.map((link) => (
						<a
							href={link.href}
							class="min-h-11 px-3 inline-flex items-center rounded-lg text-[var(--muted)] hover:text-[var(--search-blue)] hover:bg-[var(--search-blue-light)] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--search-blue)]"
						>
							{link.label}
						</a>
					))}
				</div>
				<a href="/formation" class="min-h-11 px-4 py-2 rounded-full bg-[var(--search-blue)] text-white text-sm font-semibold font-sans hover:bg-[var(--search-blue-deep)] transition inline-flex items-center justify-center shadow-sm">
					Break the cycle
				</a>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="border-t border-[var(--border)] bg-[var(--surface)] mt-8">
			<div class="max-w-5xl mx-auto px-6 py-12">
				<div class="grid md:grid-cols-3 gap-8">
					<div class="md:col-span-2">
						<p class="font-sans font-bold text-[var(--search-blue)] text-lg">Search OC</p>
						<p class="mt-2 text-[var(--muted)] max-w-md leading-relaxed">
							Equipping Christians in the marketplace to share their faith without guilt, pressure, or awkwardness. A local expression of Search Ministries, serving Orange County for over 40 years.
						</p>
					</div>
					<div class="font-sans text-sm space-y-2">
						<p class="font-semibold text-[var(--ink)]">Connect</p>
						<a href="mailto:jake@searchoc.org" class="block text-[var(--search-blue)] hover:underline min-h-11 flex items-center">jake@searchoc.org</a>
						<p class="text-[var(--muted)]">Orange County, California</p>
						<p class="text-[var(--muted)] pt-2">Jake Hartson, Area Director</p>
					</div>
				</div>
				<div class="mt-10 pt-6 border-t border-[var(--border)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-[var(--cool-gray)] font-sans">
					<p>More Jesus. Less awkward.</p>
					<div class="flex gap-4">
						<a href="/formation" class="hover:text-[var(--search-blue)]">Formation</a>
						<a href="/open-forums" class="hover:text-[var(--search-blue)]">Open Forums</a>
						<a href="/invite" class="hover:text-[var(--search-blue)]">Invite Someone</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
