---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Search OC invites adults to take a next step toward God through honest conversations and relational evangelism." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Source+Serif+4:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		<title>Search OC | Inviting adults to take a next step toward God</title>
	</head>
	<body class="bg-[#FAF8F5] text-[#1A1A1A] font-serif">
		<SpeedInsights />
		<header class="border-b border-[#E5E7EB] bg-white">
			<nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
				<a href="/" class="text-xl font-semibold tracking-tight text-[#3C8ECC] font-sans">Search OC</a>
				<div class="flex items-center gap-6 text-sm font-medium font-sans">
					<a href="/" class="hover:text-[#3C8ECC]">Home</a>
					<a href="/formation" class="hover:text-[#3C8ECC]">Formation</a>
				</div>
				<a href="mailto:jhartson@searchnational.org" class="px-4 py-2 rounded-lg bg-[#3C8ECC] text-white text-sm font-medium hover:bg-[#2a6aa3] transition">Start the conversation</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="border-t border-[#E5E7EB] bg-white mt-16">
			<div class="max-w-5xl mx-auto px-6 py-10 text-sm text-[#797A78] flex flex-col md:flex-row md:items-center md:justify-between gap-4">
				<div>
					Search OC is a local expression of Search Ministries.
					<br />
					Inviting adults to take a next step toward God.
				</div>
				<div class="font-sans">
					<a href="mailto:jhartson@searchnational.org" class="hover:text-[#3C8ECC]">jhartson@searchnational.org</a>
					<span class="mx-2">·</span>
					<span>Orange County, CA</span>
				</div>
			</div>
		</footer>
	</body>
</html>
