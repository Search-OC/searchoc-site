---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import InterestForm from '../components/InterestForm.astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogDescription?: string;
}

const SITE = 'https://searchoc.org';

const {
	title = 'Search OC | Questions about God? You are not the only one.',
	description = 'A safe place in Orange County to ask them out loud. Open Forums are hosted conversations about God. Believers and unbelievers are both welcome.',
	canonical = '/',
	ogImage = '/og/home.png',
	ogDescription = description
} = Astro.props;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/open-forums', label: 'Open Forums' },
	{ href: '/invite', label: 'Invite Someone' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={SITE + canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={SITE + canonical} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<script defer data-domain="searchoc.org" src="https://plausible.io/js/plausible.js"></script>
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Search OC",
			"description": "Search OC hosts Open Forums in Orange County where people can ask honest questions about God. Believers and unbelievers are both welcome.",
			"url": "https://searchoc.org",
			"areaServed": {
				"@type": "Place",
				"name": "Orange County, California"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "Search Ministries"
			}
		}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<SpeedInsights />
		<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--surface)]/90 backdrop-blur-md">
			<nav class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between gap-4" aria-label="Primary">
				<a href="/" class="font-sans text-lg font-bold tracking-tight text-[var(--search-blue-action)] min-h-11 inline-flex items-center gap-2">
					<span class="inline-block w-2.5 h-2.5 rounded-sm bg-[var(--orange)]" aria-hidden="true"></span>
					Search OC
				</a>
				<div class="hidden md:flex items-center gap-1 text-sm font-medium font-sans">
					{navLinks.map((link) => {
						const current = link.href === '/' ? path === '/' : path === link.href || path.startsWith(`${link.href}/`);
						return (
							<a
								href={link.href}
								aria-current={current ? 'page' : undefined}
								class:list={[
									'min-h-11 px-3 inline-flex items-center rounded-lg text-[var(--dark-teal)] hover:text-[var(--search-blue-action)] hover:bg-[var(--search-blue-light)] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--search-blue)]',
									current && 'text-[var(--search-blue-action)] bg-[var(--search-blue-light)]'
								]}
							>
								{link.label}
							</a>
						);
					})}
				</div>
				<a href="/#stay-in-touch" class="min-h-11 px-4 py-2 rounded-xl bg-[var(--search-blue-action)] text-white text-sm font-semibold font-sans hover:bg-[var(--dark-teal)] transition inline-flex items-center justify-center shadow-sm">
					Get involved
				</a>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="border-t border-[var(--border)] bg-[var(--surface)] mt-8">
			<div class="max-w-5xl mx-auto px-6 py-12">
				<div class="grid md:grid-cols-2 gap-10">
					<div>
						<p class="font-sans font-bold text-[var(--search-blue-action)] text-lg">Search OC</p>
						<p class="mt-2 text-[var(--muted)] max-w-md leading-relaxed">
							Search OC hosts Open Forums in Orange County: honest conversation about God, with room for believers and unbelievers at the same table. A local expression of Search Ministries, serving Orange County for over 40 years.
						</p>
						<p class="mt-4 font-sans text-sm text-[var(--cool-gray)]">Orange County, California</p>
					</div>
					<div>
						<p class="font-sans font-semibold text-[var(--ink)] mb-1">Having Killer Conversations</p>
						<p class="text-sm text-[var(--muted)] mb-4">
							A short note every other week for Christians who want to talk about faith without being weird about it.
						</p>
						<InterestForm
							formId="footer-form"
							source="footer"
							submitLabel="Subscribe"
							showName={false}
							showInterests={false}
							defaultNewsletter={true}
							compact={true}
						/>
					</div>
				</div>
				<div class="mt-10 pt-6 border-t border-[var(--border)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-[var(--cool-gray)] font-sans">
					<p>More Jesus. Less awkward.</p>
					<div class="flex gap-4">
						<a href="/open-forums" class="hover:text-[var(--search-blue-action)]">Open Forums</a>
						<a href="/invite" class="hover:text-[var(--search-blue-action)]">Invite Someone</a>
						<a href="/#stay-in-touch" class="hover:text-[var(--search-blue-action)]">Get involved</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
