---
interface Props {
  title: string;
  body: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: 'default' | 'blue';
}

const {
  title,
  body,
  primaryLabel = 'Start the conversation',
  primaryHref = 'mailto:jake@searchoc.org',
  secondaryLabel,
  secondaryHref,
  variant = 'default',
} = Astro.props;

const isBlue = variant === 'blue';
---

<section class={`max-w-5xl mx-auto px-6 section ${isBlue ? 'section-blue rounded-3xl my-8 mx-4 md:mx-auto' : ''}`}>
  <div class={`max-w-2xl ${isBlue ? 'mx-auto text-center' : ''}`}>
    <h2 class={`text-2xl md:text-3xl font-bold tracking-tight ${isBlue ? 'text-white' : ''}`}>{title}</h2>
    <p class={`mt-3 lead ${isBlue ? 'text-white/85 !text-lg' : ''}`}>{body}</p>
    <div class={`mt-6 flex flex-col sm:flex-row gap-3 ${isBlue ? 'justify-center' : ''}`}>
      <a
        href={primaryHref}
        class={`${isBlue ? 'bg-white text-[var(--search-blue)] hover:bg-white/90' : 'btn-primary'} inline-flex items-center justify-center min-h-11 px-6 rounded-full font-sans font-semibold transition`}
      >
        {primaryLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class={`${isBlue ? 'border-2 border-white/40 text-white hover:bg-white/10' : 'btn-secondary'} inline-flex items-center justify-center min-h-11 px-6 rounded-full font-sans font-semibold transition`}
        >
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>
