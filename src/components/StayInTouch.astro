---
import Eyebrow from './Eyebrow.astro';
import InterestForm from './InterestForm.astro';

interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	body?: string;
	source: string;
	variant?: 'default' | 'blue' | 'warm';
	submitLabel?: string;
	showName?: boolean;
	showMessage?: boolean;
	showGuestName?: boolean;
	showInterests?: boolean;
	defaultInterests?: string[];
	defaultNewsletter?: boolean;
	compact?: boolean;
}

const {
	id = 'stay-in-touch',
	eyebrow = 'Stay in touch',
	title,
	body,
	source,
	variant = 'default',
	submitLabel,
	showName,
	showMessage,
	showGuestName,
	showInterests,
	defaultInterests,
	defaultNewsletter,
	compact,
} = Astro.props;

const isBlue = variant === 'blue';
const isWarm = variant === 'warm';
const sectionClass = isBlue
	? 'section-blue rounded-3xl my-8 mx-4 md:mx-auto'
	: isWarm
		? 'section-warm'
		: '';
const textClass = isBlue ? 'text-white' : '';
const bodyClass = isBlue ? 'text-white' : 'text-[var(--muted)]';
---

<section id={id} class={`section ${sectionClass}`}>
	<div class="max-w-5xl mx-auto px-6">
		<div class={`max-w-xl ${isBlue ? 'mx-auto text-center' : ''}`}>
			{eyebrow && (
				<Eyebrow text={eyebrow} variant={isBlue ? 'white' : isWarm ? 'amber' : 'blue'} />
			)}
			<h2 class={`mt-3 text-2xl md:text-3xl font-bold tracking-tight ${textClass}`}>{title}</h2>
			{body && (
				<p class={`mt-3 lead ${bodyClass} ${isBlue ? '!text-lg' : ''}`}>{body}</p>
			)}
			<div class={`mt-6 ${isBlue ? 'text-left stay-in-touch-on-dark' : ''}`}>
				<InterestForm
					formId={`${id}-form`}
					source={source}
					submitLabel={submitLabel}
					showName={showName}
					showMessage={showMessage}
					showGuestName={showGuestName}
					showInterests={showInterests}
					defaultInterests={defaultInterests}
					defaultNewsletter={defaultNewsletter}
					compact={compact}
				/>
			</div>
		</div>
	</div>
</section>
